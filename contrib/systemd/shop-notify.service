[Unit]
Description=Shop listing notifier (shop-notify)
Documentation=https://github.com/spielkind/shop-notify
Wants=network-online.target
After=network-online.target

[Service]
Type=notify
NotifyAccess=main
# The service pings the watchdog while it waits between polls; a single poll
# (including Etsy rate-limit back-off) may take a few minutes.
WatchdogSec=15min
TimeoutStartSec=5min
User=shop-notify
Group=shop-notify
WorkingDirectory=/opt/shop-notify
ExecStart=/opt/shop-notify/.venv/bin/shop-notify
# Environment variables take precedence over /opt/shop-notify/.env
Environment=DB_PATH=/var/lib/shop-notify/shop-notify.db
Environment=LOG_FILE=
Environment=PYTHONUNBUFFERED=1
StateDirectory=shop-notify
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=30

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
