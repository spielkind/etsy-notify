[Unit]
Description=Shop listing notifier (etsy-notify)
Documentation=https://github.com/spielkind/etsy-notify
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=etsy-notify
Group=etsy-notify
WorkingDirectory=/opt/etsy-notify
ExecStart=/opt/etsy-notify/.venv/bin/etsy-notify
# Environment variables take precedence over /opt/etsy-notify/.env
Environment=DB_PATH=/var/lib/etsy-notify/etsy.db
Environment=LOG_FILE=
Environment=PYTHONUNBUFFERED=1
StateDirectory=etsy-notify
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=30

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
