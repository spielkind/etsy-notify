<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ subject }}</title>
</head>
<body style="margin:0;padding:0;background:#FFF8F1;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#FFF8F1;">
<tr><td align="center" style="padding:24px 12px;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#264653;">
  <tr><td style="padding:0 0 16px 0;">
    <div style="font-size:22px;font-weight:800;">{{ subject }}</div>
    <div style="height:4px;width:64px;background:#E76F51;border-radius:2px;margin-top:8px;"></div>
  </td></tr>
{% for item in listings %}
  <tr><td style="padding:0 0 16px 0;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#FFFFFF;border-radius:12px;overflow:hidden;box-shadow:0 2px 8px rgba(122,59,46,0.12);">
{% if item.image_url %}
      <tr><td>
        <a href="{{ item.url }}"><img src="{{ item.image_url }}" alt="{{ item.title }}" width="600" style="display:block;width:100%;max-width:600px;height:auto;border:0;"></a>
      </td></tr>
{% endif %}
      <tr><td style="padding:16px 20px;">
        <a href="{{ item.url }}" style="font-size:17px;font-weight:700;color:#264653;text-decoration:none;">{{ item.title }}</a>
        <div style="margin-top:6px;font-size:14px;color:#6B4E45;">
{% if item.price %}
          <strong style="color:#D1495B;">{{ item.price | money }}</strong> &middot;
{% endif %}
          {{ item.listed | localtime }}
        </div>
        <div style="margin-top:12px;">
          <a href="{{ item.url }}" style="display:inline-block;padding:8px 16px;background:#2A9D8F;color:#FFFFFF;border-radius:6px;font-size:14px;font-weight:600;text-decoration:none;">Ansehen</a>
        </div>
      </td></tr>
    </table>
  </td></tr>
{% endfor %}
  <tr><td style="padding:8px 0 0 0;font-size:12px;color:#9C8A83;text-align:center;">
    Gesendet von Shop Notify
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
